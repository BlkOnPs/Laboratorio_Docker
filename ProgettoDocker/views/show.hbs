
  <main class="container">
    <a href="/" class="back"><i class="bi bi-arrow-left"></i> Tutti gli utenti</a>

    <section class="panel">
      <div class="profile-head">
        <div class="avatar avatar-lg">{{user.name}}{{user.surname}}</div>
        <div>
          <h1>{{user.name}} {{user.surname}}</h1>
          {{#if user.dipendente}}
            <span class="badge badge-yes"><i class="bi bi-briefcase-fill"></i> Dipendente</span>
          {{else}}
            <span class="badge badge-no"><i class="bi bi-person"></i> Non dipendente</span>
          {{/if}}
        </div>
      </div>

      <dl class="details">
        <div><dt><i class="bi bi-hash"></i> ID</dt><dd>{{user.id}}</dd></div>
        <div><dt><i class="bi bi-person"></i> Nome</dt><dd>{{user.name}}</dd></div>
        <div><dt><i class="bi bi-person"></i> Cognome</dt><dd>{{user.surname}}</dd></div>
        <div><dt><i class="bi bi-shield-check"></i> Ruolo</dt><dd>{{#if user.role}}{{user.role.name}}{{else}}Nessun ruolo{{/if}}</dd></div>
        <div><dt><i class="bi bi-building"></i> Indirizzo</dt><dd>{{user.address}}</dd></div>
        <div><dt><i class="bi bi-house"></i> Città</dt><dd>{{user.city}}</dd></div>
        <div><dt><i class="bi bi-phone"></i> Numero telefonico</dt><dd>{{user.phone_number}}</dd></div>
        <div class="full"><dt><i class="bi bi-card-text"></i> Descrizione ruolo</dt><dd>{{#if user.role.description}}{{user.role.description}}{{else}}—{{/if}}</dd></div>
      </dl>

      <div class="form-actions">
        <a href="/edit/{{user.id}}" class="btn btn-primary"><i class="bi bi-pencil"></i> Modifica</a>
        <form method="POST" action="/delete/{{user.id}}"
              onsubmit="return confirm('Vuoi eliminare {{user.name}} {{user.surname}}? L\'azione non si può annullare.');">
          <button type="submit" class="btn btn-danger"><i class="bi bi-trash3"></i> Elimina</button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>
